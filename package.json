{
  "name": "electron-starter",
  "productName": "Electron Starter",
  "version": "0.6.1",
  "description": "Electron app starter with React, Tailwind CSS, and shadcn/ui",
  "main": "dist/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite dev",
    "package": "electron-vite build && electron-builder build --dir",
    "make": "electron-vite build && electron-builder build",
    "make:win": "electron-vite build && electron-builder build --win",
    "make:mac": "electron-vite build && electron-builder build --mac",
    "make:linux": "electron-vite build && electron-builder build --linux",
    "lint": "eslint . --fix",
    "type-check": "tsc --noEmit --composite false --declaration false --rootDir . -p src/main/tsconfig.json && tsc --noEmit --composite false --declaration false --rootDir . -p src/preload/tsconfig.json && tsc --noEmit --composite false --declaration false --rootDir . -p src/renderer/tsconfig.json",
    "format": "prettier --write .",
    "release": "dotenv -- release-it",
    "release:patch": "dotenv -- release-it patch",
    "release:minor": "dotenv -- release-it minor",
    "release:major": "dotenv -- release-it major",
    "bump-shadcn-components": "ts-node ./scripts/bump-shadcn-components.ts",
    "init-project": "node scripts/init.mjs",
    "new:feature": "node scripts/new-feature.mjs",
    "generate-icons": "node scripts/generate-icons.mjs"
  },
  "author": "Corey Peruffo <cperuffo3@gmail.com>",
  "license": "MIT",
  "prettier": {
    "singleQuote": false,
    "trailingComma": "all",
    "tabWidth": 2,
    "semi": true,
    "endOfLine": "auto",
    "importOrder": [
      "<THIRD_PARTY_MODULES>",
      "^@main/(.*)$",
      "^@shared/(.*)$",
      "^@/(.*)$",
      "^[./]"
    ],
    "importOrderSeparation": true,
    "importOrderSortSpecifiers": true,
    "importOrderParserPlugins": [
      "typescript",
      "jsx"
    ],
    "plugins": [
      "@trivago/prettier-plugin-sort-imports",
      "prettier-plugin-tailwindcss"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore(release): v${version}",
      "tagName": "v${version}",
      "tagAnnotation": "Release v${version}",
      "requireBranch": "main",
      "requireCleanWorkingDir": true,
      "requireUpstream": true
    },
    "github": {
      "release": false,
      "tokenRef": "GH_TOKEN"
    },
    "npm": {
      "publish": false
    },
    "hooks": {
      "before:init": [
        "pnpm run lint",
        "pnpm run type-check"
      ],
      "after:bump": "pnpm install --lockfile-only && pnpm run format"
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "conventionalcommits",
          "types": [
            {
              "type": "feat",
              "section": "Features"
            },
            {
              "type": "fix",
              "section": "Bug Fixes"
            },
            {
              "type": "perf",
              "section": "Performance"
            },
            {
              "type": "refactor",
              "section": "Refactoring"
            },
            {
              "type": "docs",
              "section": "Documentation"
            },
            {
              "type": "chore",
              "hidden": true
            },
            {
              "type": "style",
              "hidden": true
            },
            {
              "type": "test",
              "hidden": true
            }
          ]
        },
        "infile": "CHANGELOG.md",
        "writerOpts": {
          "commitPartial": "- {{header}}\n"
        }
      }
    }
  },
  "devDependencies": {
    "@electron/fuses": "~2.1.3",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@inquirer/prompts": "^8.4.3",
    "@release-it/conventional-changelog": "^11.0.1",
    "@tailwindcss/node": "^4.3.2",
    "@tanstack/router-plugin": "^1.167.35",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "^6.0.3",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv-cli": "^11.0.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.0.2",
    "eslint-plugin-check-file": "^3.3.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-tailwind-canonical-classes": "^1.3.3",
    "globals": "^17.7.0",
    "icon-gen": "^5.0.0",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "release-it": "^20.2.1",
    "tailwindcss": "^4.3.2",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.4",
    "vite-plugin-static-copy": "^4.1.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@orpc/client": "^1.14.6",
    "@orpc/server": "^1.14.3",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-router-devtools": "^1.167.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.2.1",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.22.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.0",
    "react": "^19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.6",
    "react-number-format": "^5.4.5",
    "react-resizable-panels": "^4.12.0",
    "recharts": "3.9.0",
    "shadcn": "^4.12.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  }
}
