{
  // Solution-style config: real settings live in the per-process configs
  // (src/main, src/preload, src/renderer, extending src/tsconfig.base.json).
  // The paths below are duplicated here for tools (e.g. shadcn CLI) that only
  // read the root tsconfig.
  "files": [],
  "references": [
    { "path": "./src/main" },
    { "path": "./src/preload" },
    { "path": "./src/renderer" }
  ],
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/renderer/*"],
      "@main/*": ["./src/main/*"],
      "@shared/*": ["./src/shared/*"]
    }
  }
}
